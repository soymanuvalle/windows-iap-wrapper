{
  "compilerOptions": {
    "declaration": true,
    "lib": ["ES2022"],
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./lib",
    "strict": true,
    "target": "ES2020",
    "types": ["node"],
    "typeRoots": ["node_modules/@types"],
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["lib/**/*"]
}
